        <p data-template-id="q5-explanation" class="canva-text explanation hidden mt-3 leading-relaxed" style="color: rgb(184, 200, 189); font-weight: 400; font-style: normal; font-size: 16px;">Karena label “Campuran” pasti salah, kotak itu berisi satu jenis buah saja. Satu buah yang diambil mengungkap isinya; dua kotak lain dapat ditentukan dari label yang juga salah.</p>
       </section>
      </div>
      <div id="feedback" class="hidden mt-7 pt-6 border-t" style="border-color:#38504c" role="status" aria-live="polite">
       <p data-template-id="feedback-correct" id="correct-message" class="canva-text font-bold mb-1 hidden" style="color: rgb(233, 250, 115); font-weight: 700; font-style: normal; font-size: 16px;">Tepat sekali! +20 poin.</p>
       <p data-template-id="feedback-wrong" id="wrong-message" class="canva-text font-bold mb-1 hidden" style="color: rgb(255, 151, 135); font-weight: 700; font-style: normal; font-size: 16px;">Belum tepat. Simak penjelasannya!</p><button type="button" id="next-button" data-template-id="next-button" class="canva-button primary-action rounded-xl px-6 py-3 font-bold mt-5" style="background: rgb(233, 250, 115); color: rgb(20, 32, 28); font-weight: 700; font-style: normal; font-size: 16px;">Lanjut ke level berikutnya →</button>
      </div>
     </section>
     <section id="result" class="game-panel rounded-3xl p-7 sm:p-12 text-center hidden">
      <p data-template-id="result-kicker" class="canva-text mono tracking-widest mb-4" style="color: rgb(233, 250, 115); font-size: 12px; font-weight: 400; font-style: normal;">TANTANGAN SELESAI</p>
      <h2 data-template-id="result-title" class="canva-text font-extrabold mb-3" style="color: rgb(245, 244, 233); font-weight: 800; font-style: normal; font-size: 24px;">Pikiranmu sudah diuji.</h2>
      <p data-template-id="result-subtitle" class="canva-text mb-8" style="color: rgb(184, 200, 189); font-weight: 400; font-style: normal; font-size: 16px;">Inilah hasil dari lima teka-teki logika.</p>
      <div class="inline-flex items-baseline gap-2 mb-9"><span id="final-score" class="mono font-bold text-6xl sm:text-7xl" style="color:#e9fa73" aria-live="polite">0</span> <span data-template-id="score-total" class="canva-text mono" style="color: rgb(184, 200, 189); font-weight: 400; font-style: normal; font-size: 16px;">/ 100 poin</span>
      </div>
      <div>
       <button type="button" id="restart-button" data-template-id="restart-button" class="canva-button primary-action rounded-xl px-8 py-4 font-bold" style="background: rgb(233, 250, 115); color: rgb(20, 32, 28); font-weight: 700; font-style: normal; font-size: 16px;">Main lagi ↺</button>
      </div>
     </section>
    </main>
    <footer class="pt-10 pb-3">
     <p data-template-id="footer-note" class="canva-text mono tracking-wider" style="color: rgb(184, 200, 189); font-size: 11px; font-weight: 400; font-style: normal;">PIKIR PELAN. TEMUKAN POLANYA. TAKLUKKAN LEVELNYA.</p>
    </footer>
   </div>
  </div>
  <script>
    const puzzles = [...document.querySelectorAll('.puzzle')];
    const game = document.getElementById('game');
    const result = document.getElementById('result');
    const feedback = document.getElementById('feedback');
    let current = 0;
    let score = 0;
    let answered = false;

    function updateStats() {
      document.getElementById('score').textContent = String(score);
      document.getElementById('level-count').textContent =
        String(current + 1).padStart(2, '0') + ' / ' + String(puzzles.length).padStart(2, '0');
      document.getElementById('progress').setAttribute('aria-valuenow', String(current));
      document.getElementById('progress-fill').style.width = (current / puzzles.length * 100) + '%';
    }

    puzzles.forEach((puzzle, puzzleIndex) => {
      const buttons = [...puzzle.querySelectorAll('.choice')];
      buttons.forEach((button, choiceIndex) => {
        button.addEventListener('click', () => {
          if (puzzleIndex !== current || answered) return;
          answered = true;
          const correctIndex = Number(puzzle.dataset.answer);
          const isCorrect = choiceIndex === correctIndex;
          if (isCorrect) score += 20;
          buttons.forEach((option, index) => {
            option.disabled = true;
            if (index === correctIndex) option.classList.add('is-correct');
            else if (index === choiceIndex) option.classList.add('is-wrong');
            else option.classList.add('is-dim');
          });
          puzzle.querySelector('.explanation').classList.remove('hidden');
          document.getElementById('correct-message').classList.toggle('hidden', !isCorrect);
          document.getElementById('wrong-message').classList.toggle('hidden', isCorrect);
          feedback.classList.remove('hidden');
          updateStats();
        });
      });
    });

    document.getElementById('next-button').addEventListener('click', () => {
      if (!answered) return;
      puzzles[current].classList.add('hidden');
      current++;
      answered = false;
      feedback.classList.add('hidden');
      if (current === puzzles.length) {
        game.classList.add('hidden');
        result.classList.remove('hidden');
        document.getElementById('final-score').textContent = String(score);
        document.getElementById('progress').setAttribute('aria-valuenow', String(puzzles.length));
        document.getElementById('progress-fill').style.width = '100%';
        document.getElementById('restart-button').focus();
      } else {
        puzzles[current].classList.remove('hidden');
        updateStats();
        puzzles[current].querySelector('.choice').focus();
      }
    });

    document.getElementById('restart-button').addEventListener('click', () => {
      current = 0;
      score = 0;
      answered = false;
      puzzles.forEach((puzzle, index) => {
        puzzle.classList.toggle('hidden', index !== 0);
        puzzle.querySelector('.explanation').classList.add('hidden');
        puzzle.querySelectorAll('.choice').forEach(button => {
          button.disabled = false;
          button.classList.remove('is-correct', 'is-wrong', 'is-dim');
        });
      });
      feedback.classList.add('hidden');
      result.classList.add('hidden');
      game.classList.remove('hidden');
      updateStats();
      puzzles[0].querySelector('.choice').focus();
    });
    updateStats();
  </script>
 
